PORT=8080
# Set to your actual Vercel site URL(s), separated by comma.
ALLOWED_ORIGINS=https://your-anblox.vercel.app
# Set a LONG random private secret for publishing the 20-question pack.
ADMIN_KEY=replace-this-with-a-very-long-random-secret

# OPTIONAL: path on a host-mounted durable disk (do not publish answer keys).
# A local source file on ephemeral hosting WILL NOT retain edits across redeploys.
# QUESTION_STORE_PATH=/data/anblox/questions.json
